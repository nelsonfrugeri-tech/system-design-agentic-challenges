# Documentation only: never put real credentials in the repository.
# start.sh generates infra/langfuse/.env once (git-ignored, mode 600).
# Reuse it on every restart; do not rotate secrets against existing volumes.
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_INIT_USER_EMAIL=admin@localhost.local
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
SALT=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=
# Local-only login, fixed on purpose so it is always the same.
LANGFUSE_INIT_USER_PASSWORD=12345678
